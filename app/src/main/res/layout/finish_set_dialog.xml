<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dialogRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/finish_set_background"
    android:focusableInTouchMode="true"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/finish_set_title"
        android:textColor="@color/app_text"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/exerciseName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="@color/app_text"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/currentWeight"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/app_text_muted" />

    <TextView
        android:id="@+id/nextExercise"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/app_text_muted" />

    <EditText
        android:id="@+id/newWeight"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/new_weight_hint"
        android:inputType="number"
        android:background="@drawable/app_input_background"
        android:importantForAutofill="no"
        android:maxLines="1"
        android:minHeight="48dp"
        android:padding="12dp"
        android:textColor="@color/app_text"
        android:textColorHint="@color/app_text_muted" />

    <TextView
        android:id="@+id/errorText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/app_error"
        android:visibility="gone" />

    <Button
        android:id="@+id/skipNextButton"
        style="?android:attr/buttonBarButtonStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/app_secondary_button_background"
        android:minHeight="48dp"
        android:text="@string/skip_next_exercise"
        android:textAllCaps="false"
        android:textColor="@color/app_text" />

    <LinearLayout
        style="?android:attr/buttonBarStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/keepButton"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/app_secondary_button_background"
            android:minHeight="48dp"
            android:textAllCaps="false"
            android:textColor="@color/app_text"
            android:text="@string/keep_exercise" />

        <Button
            android:id="@+id/nextButton"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/app_primary_button_background"
            android:minHeight="48dp"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:text="@string/next_exercise" />
    </LinearLayout>
</LinearLayout>
